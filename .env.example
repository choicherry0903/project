# Copy to .env. Use Session pooler values from Supabase > Connect.
# Database password, not an API key. Keep values unquoted; never commit .env.
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=interior_cms&connectTimeout=10
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=replace-with-your-supabase-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Resend: verify the sending domain, create an API key, then set these values.
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=noreply@your-verified-domain.example
APP_PUBLIC_BASE_URL=https://your-app.example
# R2: endpoint must not include the bucket path. Keys stay server-side.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=roofandwall
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
