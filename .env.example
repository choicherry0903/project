# Copy to .env and replace the example values. Never commit real credentials.
# The mysql profile imports .env from the working directory (project root).
# Docker Compose and scripts/run-local.ps1 also read .env.
# For a shared DB use mysql,shared and the DB_URL supplied by the DB owner.
# DB_URL=jdbc:mysql://VPN_HOST:13306/interior_cms?sslMode=REQUIRED&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_NAME=interior_cms
DB_USERNAME=interior_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-at-least-12-characters
