# Copy to .env. Use Session pooler values from Supabase > Connect.
# Database password, not an API key. Keep values unquoted; never commit .env.
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=interior_cms&connectTimeout=10
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=replace-with-your-supabase-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
